# Mercado Pago (credenciales de prueba/sandbox)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Gmail SMTP para enviar comprobantes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Se completa automáticamente al arrancar el tunnel de Cloudflare en Docker.
# Para desarrollo local sin Docker, dejar un valor explícito como http://localhost:5173.
FRONTEND_URL=
