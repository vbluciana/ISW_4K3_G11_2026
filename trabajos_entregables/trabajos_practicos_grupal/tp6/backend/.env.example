# Puerto del servidor HTTP
PORT=3000

# Mercado Pago (Checkout Pro - credenciales de prueba/sandbox de la cuenta del grupo)
# No commitear el .env real: copiar este archivo a .env y completar los valores.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Email (SMTP Gmail) usado para el correo de confirmación de compra
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# URLs de retorno de Mercado Pago (Checkout Pro)
FRONTEND_URL=http://localhost:5173

# Si está en "true", los tests de integración-real pegan contra Mercado Pago
# y Gmail de verdad en vez de usar los dobles de prueba (fakes). Por defecto
# apagado para que la suite sea rápida, determinística y no dependa de red.
ENABLE_REAL_INTEGRATIONS=false
